// and yields its first falsey operand, otherwise the last one. The result is
// the operand itself rather than a bool.
assert((false and 1) == false);
assert((true and 1) == 1);
assert((1 and 2) == 2);
assert((nil and "bad") == nil);

// or yields its first truthy operand, otherwise the last one.
assert((false or 1) == 1);
assert((true or "bad") == true);
assert((nil or "ok") == "ok");
assert((nil or false) == false);

// Both short circuit, so the right operand is not evaluated when the left one
// already decides the result.
var evaluated = false;
fun mark() {
    evaluated = true;
    return true;
}

false and mark();
assert(evaluated == false, "and skipped its right operand");

true or mark();
assert(evaluated == false, "or skipped its right operand");

true and mark();
assert(evaluated, "and evaluated its right operand when it had to");
