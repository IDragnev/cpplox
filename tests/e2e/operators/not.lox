// ! negates truthiness and always yields a bool. Only nil and false are
// falsey, so everything else negates to false.

assert(!true == false);
assert(!false == true);
assert(!!true == true);
assert(!!false == false);

assert(!nil == true);

assert(!123 == false);
assert(!0 == false);
assert(!"" == false);
assert(!"text" == false);

assert(type(!0) == "bool");
