// A global name is looked up when the call runs rather than when the body is
// compiled, so a function may call one declared further down the file.
fun first() {
    return second();
}

fun second() {
    return "second";
}

assert(first() == "second");

// Which is what lets two functions call each other.
fun isEven(n) {
    if (n == 0) return true;
    return isOdd(n - 1);
}

fun isOdd(n) {
    if (n == 0) return false;
    return isEven(n - 1);
}

assert(isEven(0));
assert(isEven(10));
assert(isOdd(7));
assert(isEven(7) == false);
assert(isOdd(10) == false);
