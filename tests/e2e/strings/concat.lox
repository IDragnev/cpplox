var a = "hello";
var b = " ";
var c = "world";
assert(a + b + c == "hello world");

// Concatenation of empty strings.
assert("" + "abc" == "abc");
assert("abc" + "" == "abc");
assert("" + "" == "");

// Concatenation builds a new string rather than changing its operands.
assert(a == "hello");
assert(c == "world");
