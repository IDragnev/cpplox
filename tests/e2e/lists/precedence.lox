// A subscript is a postfix operator in the same tier as calls and property
// access, so it binds tighter than the unary operators...
var xs = [2, 3, 4];
assert(-xs[0] == -2);
assert(!xs[0] == false);
var flags = [false];
assert(!flags[0]);

// ...and tighter than every binary operator.
assert(xs[0] + xs[1] * xs[2] == 14);
assert(xs[0] * xs[1] + xs[2] == 10);
assert(xs[0] < xs[1]);
assert(xs[0] == 2 and xs[1] == 3);

// The index is a full expression, so even an assignment is allowed inside it.
var i = 0;
assert(xs[i = 2] == 4);
assert(i == 2);

// Grouping decides what is subscripted.
assert(([1] + [2])[1] == 2);
