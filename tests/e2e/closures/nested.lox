// A closure reaches locals from every enclosing function, not just the
// immediate one.
var f;

fun f1() {
    var a = "a";
    fun f2() {
        var b = "b";
        fun f3() {
            var c = "c";
            fun f4() {
                return a + b + c;
            }
            f = f4;
        }
        f3();
    }
    f2();
}
f1();

assert(f() == "abc");
