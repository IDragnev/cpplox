// Two closures over the same local share one variable, so an assignment made
// through one is visible through the other.
var f;
var g;

{
    var local = "local";
    fun f_() {
        var seen = local;
        local = "after f";
        return seen;
    }
    f = f_;

    fun g_() {
        var seen = local;
        local = "after g";
        return seen;
    }
    g = g_;
}

assert(f() == "local");
assert(g() == "after f");
assert(f() == "after g");
