// Continue in a for loop closes captured locals.
var closure;

for (var i = 0; i < 4; i = i + 1) {
    var x = i * 10;
    fun capture() {
        return x;
    }
    if (i == 1) {
        closure = capture;
        continue;
    }
}

assert(closure() == 10, "the closure kept the value from the skipped iteration");
