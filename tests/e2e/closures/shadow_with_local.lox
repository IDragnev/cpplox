// A local declared inside a block shadows a captured variable only for the
// rest of that block.
{
    var foo = "closure";
    var trace = "";
    fun f() {
        {
            trace = trace + foo + ",";
            var foo = "shadow";
            trace = trace + foo + ",";
        }
        trace = trace + foo;
    }
    f();

    assert(trace == "closure,shadow,closure", trace);
}
