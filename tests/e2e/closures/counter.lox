fun makeCounter() {
    var count = 0;
    fun increment() {
        count = count + 1;
        return count;
    }
    return increment;
}

// The captured local persists across calls.
var counter = makeCounter();
assert(counter() == 1);
assert(counter() == 2);
assert(counter() == 3);

// A second counter closes over its own variable.
var counter2 = makeCounter();
assert(counter2() == 1, "the new counter started from zero");
assert(counter() == 4, "the first counter was unaffected");
