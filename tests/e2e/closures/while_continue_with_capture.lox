// Continue in a while loop closes captured locals.
var closure;
var i = 0;

while (i < 4) {
    var x = i * 100;
    fun capture() {
        return x;
    }
    i = i + 1;
    if (i == 2) {
        closure = capture;
        continue;
    }
}

assert(closure() == 100, "the closure kept the value from the skipped iteration");
