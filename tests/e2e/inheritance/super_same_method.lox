var trace = "";

class Base {
    foo() {
        trace = trace + "Base.foo(),";
    }
}

class Derived < Base {
    foo() {
        trace = trace + "Derived.foo(),";
        super.foo();
    }
}

// super.foo() reaches the superclass method rather than recursing into the
// override with the same name.
Derived().foo();
assert(trace == "Derived.foo(),Base.foo(),", trace);
