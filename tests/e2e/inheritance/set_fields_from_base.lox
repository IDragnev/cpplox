// Fields live on the instance rather than the class, so inherited and derived
// methods read and write the same ones.
class Foo {
    foo(a, b) {
        this.field1 = a;
        this.field2 = b;
    }

    fooRead() {
        return this.field1 + "/" + this.field2;
    }
}

class Bar < Foo {
    bar(a, b) {
        this.field1 = a;
        this.field2 = b;
    }

    barRead() {
        return this.field1 + "/" + this.field2;
    }
}

var bar = Bar();
bar.foo("foo 1", "foo 2");
assert(bar.fooRead() == "foo 1/foo 2");

bar.bar("bar 1", "bar 2");
assert(bar.barRead() == "bar 1/bar 2");
assert(bar.fooRead() == "bar 1/bar 2");
