class Base {
    method() {
        return "Base.method()";
    }
}

class Derived < Base {
    method() {
        return super.method();
    }
}

class OtherBase {
    method() {
        return "OtherBase.method()";
    }
}

var derived = Derived();
assert(derived.method() == "Base.method()");

// The superclass is captured when the class is declared, so reassigning the
// variable it came from does not change it.
Base = OtherBase;
assert(derived.method() == "Base.method()");
