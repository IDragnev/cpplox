var trace = "";

class Base {
    greet() {
        trace = trace + "Base,";
    }
}

class Derived < Base {
    greet() {
        super.greet();
        trace = trace + "Derived,";
    }
}

// super runs the overridden method, and the override continues afterwards.
Derived().greet();
assert(trace == "Base,Derived,", trace);
