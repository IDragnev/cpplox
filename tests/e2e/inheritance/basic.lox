class Animal {
    speak() {
        return "...";
    }
}

class Dog < Animal {
    speak() {
        return "Woof!";
    }
}

class Cat < Animal {}

// An override wins, and a subclass without one inherits the method.
assert(Dog().speak() == "Woof!");
assert(Cat().speak() == "...");
assert(Animal().speak() == "...");
