var trace = "";

class Base {
    init(a, b) {
        trace = trace + "Base.init(" + a + ", " + b + ")";
    }
}

class Derived < Base {
    init() {
        trace = trace + "Derived.init();";
        super.init("a", "b");
    }
}

// The subclass constructor runs first and chains to the superclass one.
Derived();
assert(trace == "Derived.init();Base.init(a, b)", trace);
