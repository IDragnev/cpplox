// str renders a value the way print writes it, and returns a string.
assert(type(str(1)) == "string");

assert(str("hi") == "hi");
assert(str("") == "");
assert("got " + str("hi") == "got hi");

assert(str(nil) == "nil");
assert(str(true) == "true");
assert(str(false) == "false");

// Every number is floating-point, but whole values render without a
// fractional part.
assert(str(0) == "0");
assert(str(123) == "123");
assert(str(987654) == "987654");
assert(str(123.456) == "123.456");
assert(str(-0.001) == "-0.001");

// Negative zero keeps its sign.
assert(str(-0) == "-0");
assert(str(3 - 5) == "-2");

// A value gets as many digits as it needs to read back as the same number,
// which is where a fraction that has no exact form shows its full length.
assert(str(1 / 3) == "0.3333333333333333");
assert(str(0.1 + 0.2) == "0.30000000000000004");

// Past sixteen digits of magnitude the rendering switches to an exponent, in
// either direction, and writes the exponent with at least two digits.
assert(str(1000000000000000) == "1000000000000000");
assert(str(10000000000000000) == "1e+16");
assert(str(0.0001) == "0.0001");
assert(str(0.00001) == "1e-05");

// There is no way to write an infinity, and a literal too large to hold is
// rejected rather than rounded up to one, but arithmetic can still overflow
// into one. It renders by name.
var big = 1e200;
assert(str(big * big) == "inf");
assert(str(-(big * big)) == "-inf");

// Objects render with their kind and name. Functions and methods also show
// their arity.
fun f() {}
fun g(a, b) {}
class Foo {
    bar() {}
}
var foo = Foo();

assert(str(f) == "<fun f:0>");
assert(str(g) == "<fun g:2>");
assert(str(Foo) == "<class Foo>");
assert(str(foo) == "<Foo instance>");
assert(str(foo.bar) == "<fun bar:0>");

// Natives show their arity too: a fixed count, a range, or * for any number.
assert(str(clock) == "<native fun clock:0>");
assert(str(str) == "<native fun str:1>");
assert(str(assert) == "<native fun assert:1-2>");
assert(str(print) == "<native fun print:*>");
