// This is the only test that matches standard output, because writing to it is
// what print does. The rendering of each value type is covered by str.lox.

// One value per line.
print(1); // expect: 1
print(1, 2, 3);
// expect: 1
// expect: 2
// expect: 3

// With no values left to separate there is still a line to write.
print();
// expect empty line

// print returns nil, so the outer call prints the inner call's result.
print(print(1));
// expect: 1
// expect: nil

// Values are written the way str renders them, which means strings arrive
// without quotes.
print("text"); // expect: text
print(str("text")); // expect: text
print(""); // expect empty line

class Foo {}
print(Foo()); // expect: <Foo instance>

// Natives are ordinary values.
fun apply(fn, arg) {
    return fn(arg);
}
print(apply(print, "hello"));
// expect: hello
// expect: nil
