// print takes any number of arguments, so its arity shows as * instead of a
// number.
print(print); // expect: <native fun print:*>
print(clock); // expect: <native fun clock:0>

// One value per line.
print(1); // expect: 1
print(1, 2, 3);
// expect: 1
// expect: 2
// expect: 3

// With no values left to separate there is still a line to write.
print();
// expect empty line

// Every value type, in a single call.
fun f() {}
class Foo {
    bar() {}
}
var foo = Foo();
print(1, "text", true, false, nil, f, Foo, foo, foo.bar);
// expect: 1
// expect: "text"
// expect: true
// expect: false
// expect: nil
// expect: <fun f:0>
// expect: <class Foo>
// expect: <Foo instance>
// expect: <fun bar:0>

// print returns nil, so the outer call prints the inner call's result.
print(print(1));
// expect: 1
// expect: nil

// Natives are ordinary values.
fun apply(fn, arg) {
    return fn(arg);
}
print(apply(print, "hello")); // expect: "hello"
// expect: nil
