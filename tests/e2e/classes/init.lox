class Rect {
    init(w, h) {
        this.width = w;
        this.height = h;
    }

    area() {
        return this.width * this.height;
    }
}

var r = Rect(3, 7);
assert(r.width == 3);
assert(r.height == 7);
assert(r.area() == 21);

// init returns the instance itself.
var r2 = Rect(5, 2);
assert(type(r2) == "instance");
assert(r2.area() == 10);
