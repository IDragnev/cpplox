class Rect {
    init(w, h) {
        this.width = w;
        this.height = h;
    }

    area() {
        return this.width * this.height;
    }
}

var r = Rect(3, 7);
assert(r.width == 3);
assert(r.height == 7);
assert(r.area() == 21);

// init returns the instance itself.
var r2 = Rect(5, 2);
assert(type(r2) == "instance");
assert(r2.area() == 10);

// A bare return leaves init early and still yields the instance.
var trace = "";
class Early {
    init() {
        trace = trace + "before,";
        return;
        trace = trace + "after,";
    }
}

var early = Early();
assert(trace == "before,", trace);
assert(type(early) == "instance", "the bare return still gave back the instance");
