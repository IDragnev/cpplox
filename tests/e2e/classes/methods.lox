class Scone {
    topping(first, second) {
        return "scone with " + first + " and " + second;
    }
}

var scone = Scone();
assert(scone.topping("berries", "cream") == "scone with berries and cream");

// A method is a callable value in its own right.
assert(type(scone.topping) == "function");
var topping = scone.topping;
assert(topping("jam", "butter") == "scone with jam and butter");
