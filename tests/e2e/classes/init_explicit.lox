var trace = "";

class Foo {
    init(arg) {
        trace = trace + "init(" + arg + ")";
        this.field = "init";
    }
}

var foo = Foo("one");
assert(trace == "init(one)", trace);

foo.field = "field";

// Calling init directly reinitializes the same instance rather than making a
// new one.
var foo2 = foo.init("two");
assert(trace == "init(one)init(two)", trace);
assert(foo2 == foo);
assert(foo.field == "init", "the field was reset by the second init");
