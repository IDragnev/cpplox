// The loop variable of a for statement lives for the whole loop, so every
// closure sees its final value. A local declared in the body is fresh each
// iteration, so each closure keeps its own.
var f1;
var f2;
var f3;

for (var i = 1; i < 4; i = i + 1) {
    var j = i;
    fun f() {
        return str(i) + ":" + str(j);
    }

    if (j == 1) f1 = f;
    else if (j == 2) f2 = f;
    else f3 = f;
}

assert(f1() == "4:1", f1());
assert(f2() == "4:2", f2());
assert(f3() == "4:3", f3());
