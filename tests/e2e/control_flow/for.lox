var trace = "";
for (var i = 0; i < 5; i = i + 1) {
    trace = trace + str(i);
}
assert(trace == "01234", trace);

// The initializer clause is optional.
trace = "";
var j = 10;
for (; j > 7; j = j - 1) {
    trace = trace + str(j) + ",";
}
assert(trace == "10,9,8,", trace);
assert(j == 7, "the loop variable is left at the value that failed the test");

// The initializer may be an expression rather than a declaration, in which case
// it runs against a variable that already exists.
trace = "";
var k = 0;
for (k = 3; k < 6; k = k + 1) {
    trace = trace + str(k);
}
assert(trace == "345", trace);
assert(k == 6);
