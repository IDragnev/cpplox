// A local declared in the body of a while loop is fresh each iteration, so
// each closure keeps its own copy.
var f1;
var f2;
var f3;

var i = 1;
while (i < 4) {
    var j = i;
    fun f() { return j; }

    if (j == 1) f1 = f;
    else if (j == 2) f2 = f;
    else f3 = f;

    i = i + 1;
}

assert(f1() == 1);
assert(f2() == 2);
assert(f3() == 3);
