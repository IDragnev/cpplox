var a = "outer";
{
    var a = "inner";
    assert(a == "inner");
}
assert(a == "outer", "the inner declaration did not outlive its block");

// Nested scopes each shadow the one outside them.
var x = 1;
{
    var x = 2;
    {
        var x = 3;
        assert(x == 3);
    }
    assert(x == 2);
}
assert(x == 1);
